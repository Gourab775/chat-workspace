# AI Gateway Configuration (required)
# SERVICE_* is canonical; AI_GATEWAY_* works as a backward-compat alias.
SERVICE_API_KEY=your-api-key
SERVICE_BASE_URL=https://ai-gateway.edgeone.link/v1

# Model (optional, defaults to @makers/hy3-preview)
# SERVICE_MODEL=@makers/hy3-preview

# ─── Chat history database (optional, Neon Postgres) ──────────────────────────
# Without this, history lives only in server memory and is lost on restart.
# DATABASE_URL=postgresql://user:password@host/db?sslmode=require

# ─── Business API Integration (optional) ────────────────────────────────────
# Provide your REST API base URL so the AI can query your backend in real time.
# Also place an api-schema.json in the project root to describe your endpoints.
# DATA_API_BASE_URL=https://api.example.com
# DATA_API_KEY=your-api-key
